# --- Required ---
# The `leagueId=` number in your ESPN league URL, e.g.
# https://fantasy.espn.com/football/league?leagueId=123456
ESPN_LEAGUE_ID=

# --- Required for private leagues ---
# Both cookies come from your browser while logged into ESPN. In Chrome:
#   DevTools -> Application -> Storage -> Cookies -> https://fantasy.espn.com
# Copy the *values* of `espn_s2` and `SWID`.
#
# espn_s2 is long (200+ chars) and URL-encoded -- paste it exactly, no quotes needed.
# SWID looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}; braces are optional.
#
# These are account-level session cookies. Keep them out of git -- .env.local is
# gitignored, and the app only ever reads them server-side.
ESPN_S2=
SWID=

# --- Optional ---
# Defaults to the current calendar year.
ESPN_SEASON_ID=

# Overrides the adaptive poll interval (25s during games, 10min otherwise).
# POLL_INTERVAL_SECONDS=30
